# ==========================================
# Application & Server Configuration
# ==========================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Security & Secret Keys
# ==========================================
# Kunci rahasia untuk enkripsi session, JWT, dll.
SECRET_KEY=your_super_secret_key_change_this_in_production
ACCESS_TOKEN=your_access_token_secret_here
REFRESH_TOKEN=your_refresh_token_secret_here

# ==========================================
# Database Credentials
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=date_time_converter_db
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# ==========================================
# External API Keys & Webhooks
# ==========================================
API_KEY=your_api_key_here
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret_token
