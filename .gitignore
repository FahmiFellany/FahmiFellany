# ==========================================
# 1. Environment & Secret Files (Keamanan)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# PENGECUALIAN: .env.example TETAP DILACAK (Jangan di-gitignore)
!.env.example

# SSH & SSL Keys
id_*
*.pub
*.pem
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.key

# ==========================================
# 2. Database & Data Storage (Sensitif)
# ==========================================
# Data SQLite & File Log WAL
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/*.db
data/*.db-journal

# File JSON Data Operasional Runtime
data/database.json
data/*.json

# ==========================================
# 3. Dependencies & Package Managers
# ==========================================
node_modules/
.pnpm-store/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# 4. OS & IDE System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE Configs
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ==========================================
# 5. Temporary & Build Artifacts
# ==========================================
dist/
build/
coverage/
scratch/
temp/
tmp/

# ==========================================
# 6. Global Pengecualian .gitkeep & .env.example
# ==========================================
# PENGECUALIAN GLOBAL: File .gitkeep di folder mana pun TETAP DILACAK untuk menjaga struktur folder kosong di Git
!.gitkeep